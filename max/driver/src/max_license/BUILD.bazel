load("//bazel:api.bzl", "mojo_library", "overlay_layer", "overlay_srcs")
load("//bazel:config.bzl", "TOP_LEVEL_TAG")

package(default_visibility = ["//max:consumers"])

_HAL_COMPAT_SRCS = [
    "_nvidia_cuda.mojo",
    "device_context.mojo",
    "device_graph.mojo",
]

# Preserve the old configuration label while DeviceContext moves to MAX.
alias(
    name = "std",
    actual = "//Mojo/stdlib/std",
    visibility = ["//visibility:public"],
)

overlay_layer(
    name = "max_base_layer",
    srcs = ["//max/mojo/max:max_srcs"],
    strip_prefix = "max/mojo/",
)

# The HAL DeviceContext, staged over MAX's gpu.host._legacy modules. Shared:
# both this package's `max_srcs_hal` and a downstream HAL max variant stack it
# over their own base (+ overlay) layers.
overlay_layer(
    name = "hal_compat",
    file_map = {
        "//max/driver/src/max_license/_device_context_hal:" + src: "max/gpu/host/_legacy/" + src
        for src in _HAL_COMPAT_SRCS
    },
    visibility = ["//visibility:public"],
)

# The same modules staged next to `_hal` as `max.gpu.host._device_context_hal`,
# so //max/mojo/max:max compiles them alongside the legacy DeviceContext.
# Nothing imports them from there yet.
overlay_layer(
    name = "hal_compat_staged_layer",
    file_map = {
        "//max/driver/src/max_license/_device_context_hal:" + src: "max/gpu/host/_device_context_hal/" + src
        for src in _HAL_COMPAT_SRCS
    } | {
        "//max/driver/src/max_license/_device_context_hal:_staged_init.mojo": "max/gpu/host/_device_context_hal/__init__.mojo",
    },
    visibility = ["//visibility:public"],
)

# Under --config=hal-device-context, stage the HAL DeviceContext and its support
# modules onto MAX's gpu.host package.
overlay_srcs(
    name = "max_srcs_hal",
    exclude = [
        # These import the legacy DeviceContext. HAL replaces that module, so
        # compiling them against the replacement fails.
        "max/gpu/host/_legacy/_device_context_extras.mojo",
        "max/gpu/host/_legacy/_device_context_metal.mojo",
        "max/gpu/host/_legacy/_metal.mojo",
    ],
    layers = [
        ":max_base_layer",
        "//max/driver/src/max_license/_hal:_hal_staged_layer",
        ":hal_compat",
    ],
)

mojo_library(
    name = "max",
    srcs = [":max_srcs_hal"],
    tags = [
        "manual",
        # Only reached through //max:max_mojo under --config=hal-device-context
        TOP_LEVEL_TAG,
    ],
    # As with `:std`, the selecting alias lives in a generated external repo.
    visibility = ["//visibility:public"],
    deps = ["@mojo//:std"],
)
