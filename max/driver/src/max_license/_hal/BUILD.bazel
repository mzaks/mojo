load("//bazel:api.bzl", "mojo_library", "overlay_layer")

package(default_visibility = ["//max:consumers"])

_HAL_SRCS = glob(["**/*.mojo"])

# Base `_hal` sources. Downstream builds overlay backend-specific files onto
# this tree to extend device support (see the `_hal` overlay in
# @plugin//max/driver/src).
filegroup(
    name = "_hal_srcs",
    srcs = _HAL_SRCS,
    tags = ["maybe-unused"],  # Consumed by external plugin repos.
    visibility = ["//visibility:public"],
)

# The HAL client API, staged onto MAX's gpu.host package with `machine` nested
# inside it. //max/mojo/max:max stacks it unconditionally, so
# `max.gpu.host._hal` resolves in every configuration.
overlay_layer(
    name = "_hal_staged_layer",
    file_map = {
        src: "max/gpu/host/_hal/" + src
        for src in _HAL_SRCS
        if src != "_machine.mojo"
    } | {
        # The staged-tree variant of `_machine.mojo` imports the nested
        # `machine` package rather than a sibling one.
        "//max/driver/src/max_license/_device_context_hal:_machine.mojo": "max/gpu/host/_hal/_machine.mojo",
        "//max/driver/src/max_license/machine:__init__.mojo": "max/gpu/host/_hal/machine/__init__.mojo",
        "//max/driver/src/max_license/machine:device.mojo": "max/gpu/host/_hal/machine/device.mojo",
        "//max/driver/src/max_license/machine:machine.mojo": "max/gpu/host/_hal/machine/machine.mojo",
    },
    visibility = ["//visibility:public"],
)

mojo_library(
    name = "_hal",
    srcs = [":_hal_srcs"],
    visibility = ["//visibility:public"],
    deps = [
        "//max:max_mojo",
        "//max/driver/src/max_license/machine",
        "@mojo//:std",
    ],
)
