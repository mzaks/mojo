load("//bazel:api.bzl", "mojo_library", "overlay_layer", "overlay_srcs", "pkg_files")

package(default_visibility = ["//max:consumers"])

# Also the base of the HAL overlay in //max/driver/src/max_license:max_srcs_hal,
# which the `//max:max_mojo` alias selects under --config=hal-device-context.
filegroup(
    name = "max_srcs",
    srcs = glob(["**/*.mojo"]),
    visibility = ["//visibility:public"],
)

overlay_layer(
    name = "max_base_layer",
    srcs = [":max_srcs"],
    strip_prefix = "max/mojo/",
)

# The HAL client API is staged in unconditionally (for now), so
# `max.gpu.host._hal` resolves without --config=hal-device-context.
overlay_srcs(
    name = "max_srcs_with_hal",
    layers = [
        ":max_base_layer",
        "//max/driver/src/max_license/_hal:_hal_staged_layer",
        "//max/driver/src/max_license:hal_compat_staged_layer",
    ],
)

mojo_library(
    name = "max",
    srcs = [":max_srcs_with_hal"],
    docs_base_path = "mojo",
    deps = [
        "//MLRT:Driver/DeviceContext",
        "@mojo//:std",
    ],
)

pkg_files(
    name = "docs",
    srcs = [":max.docs"],
    prefix = "api/mojo",
    renames = {
        ":max.docs": "max",
    },
    tags = ["manual"],
)

# Renders `max` first and pre-expanded, so its subpackages read as children
# rather than as siblings of the other top-level packages.
pkg_files(
    name = "category.docs",
    srcs = ["_category_.json"],
    prefix = "api/mojo/max",
    tags = ["manual"],
)
